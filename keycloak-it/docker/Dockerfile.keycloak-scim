# Builds little-auth/keycloak-scim-client (an in-house Keycloak SCIM *client* plugin: it
# turns Keycloak user Admin-API events into outbound SCIM calls to an external service
# provider -- the direction GitHub issue #1 needs, matching how Okta/Azure AD operate, not
# Keycloak's own newer native SCIM *server* support) from a pinned `main` commit, then
# layers the resulting jar onto Keycloak. Mirrors the pattern keycloak-scim-client's own
# `conformance/docker/Dockerfile.keycloak-scim-client` already uses for its own harness,
# reused here rather than inventing an equivalent from scratch.
#
# Targets `main` only, Slice 1 functionality (provider id `keycloak-scim-target`; config
# keys targetUrl/targetUrlAllowlistHosts/credentialVaultRef/deletePolicy/syncEnabled) -- the
# three feature branches with Basic auth, reconciliation checkpointing, and hard-delete
# confirmation UI are not merged into `main` as of this pin and are deliberately not built
# against here.

# eclipse-temurin:17 -- matches keycloak-scim-client's own `.tool-versions` pin (`java
# temurin-17.0.20+8`) and its pom.xml's `maven.compiler.source`/`target` of 17. The base
# image has no `git`, needed to clone the pinned commit below.
FROM eclipse-temurin:17-jdk AS plugin-builder
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /keycloak-scim-client
# Pinned to the tip of `main` at the time this harness was migrated to this plugin
# (2026-08-16) -- verified to build with `./mvnw clean package`, the same wrapper the
# project's own README documents.
ARG KEYCLOAK_SCIM_CLIENT_COMMIT=845386c
RUN git clone --no-checkout https://github.com/little-auth/keycloak-scim-client.git . \
    && git checkout "${KEYCLOAK_SCIM_CLIENT_COMMIT}"
RUN ./mvnw --batch-mode clean package -DskipTests

# quay.io/keycloak/keycloak:25.0.6 -- pinned to match keycloak-scim-client's pom.xml
# `<keycloak.version>25.0.6</keycloak.version>` (checked directly, not assumed); a newer
# Keycloak risks Provider SPI drift the plugin's own build hasn't caught up to.
FROM quay.io/keycloak/keycloak:25.0.6 AS keycloak-builder
COPY --from=plugin-builder \
    /keycloak-scim-client/target/keycloak-scim-client-0.1.0-SNAPSHOT.jar \
    /opt/keycloak/providers/keycloak-scim-client.jar
# `--vault=file` makes Keycloak's file-vault provider available at build time -- it must
# ALSO be selected again at runtime via KC_VAULT (see docker-compose.yml), or it's never
# actually used. Needed here because the harness resolves the SCIM target's bearer token
# through `credentialVaultRef` (a Vault SPI reference), never a raw config value -- see
# keycloak-scim-client's own conformance/README.md for the full incantation this mirrors.
RUN /opt/keycloak/bin/kc.sh build --health-enabled=true --vault=file

FROM quay.io/keycloak/keycloak:25.0.6
COPY --from=keycloak-builder /opt/keycloak/ /opt/keycloak/
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start-dev", "--health-enabled=true"]
